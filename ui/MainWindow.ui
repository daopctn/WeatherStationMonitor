}

QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    padding: 12px 30px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    margin-right: 5px;
    font-size: 14px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: rgba(255, 255, 255, 0.25);
}

QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.2);
}</string>
