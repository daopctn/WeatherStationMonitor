      <widget class="QWidget" name="tab_statistics">
       <property name="styleSheet">
        <string notr="true">QWidget {
    background: transparent;
}

QLabel {
    color: white;
}

QScrollArea {
    background: transparent;
    border: none;
}
QScrollBar::corner {
    background: transparent;
}
QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.1);
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.4);
}

/* Remove the top/bottom arrow buttons */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    background: rgba(255, 255, 255, 0.1);
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.4);
}

/* Remove the left/right arrow buttons */
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

/* Optional: remove the blank space at the corners */
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* Remove borders from all internal frames by default */
QFrame {
    background: transparent;
    border: none;
}

/* Only the big column frames get glass styling */
#frame_9, #frame_8, #frame_6, #frame_7, #frame_2, #frame_56, #frame_11, #frame_18, #frame_10, #frame_17, #frame_20, #frame_19, #frame_15, #frame_24, #frame_25, #frame_22, #frame_26, #frame_23, #frame_33, #frame_38, #frame_32,  #frame_35, #frame_34, #frame_27,#frame_39, #frame_46, #frame_47, #frame_42,#frame_43,  #frame_48, #frame_49, #frame_50, #frame_51, #frame_52, #frame_53, #frame_54   {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 15px;
    padding: 10px;
}</string>
       </property>
